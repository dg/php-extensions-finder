{
	"name": "dg/php-extensions-finder",
	"type": "project",
	"description": "🔎 PHP Extensions Finder: scans your code and lists the PHP extensions it needs, ready to paste into composer.json as ext-* requirements.",
	"keywords": ["php extensions", "composer", "composer.json", "requirements", "static analysis"],
	"license": ["BSD-3-Clause"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": ">=8.0",
		"nette/command-line": "^1.0",
		"nette/utils": "^4.0",
		"nette/tester": "^2.5",
		"nikic/php-parser": "^5.7"
	},
	"autoload": {
		"classmap": ["src/"]
	},
	"scripts": {
		"tester": "tester tests -s -C"
	},
	"bin": ["php-extensions-finder"]
}
